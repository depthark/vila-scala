---
import { Image } from 'astro:assets';

import exteriorStreet from '../assets/images/exterior-street.jpg';
import exteriorEvening from '../assets/images/exterior-evening.jpg';
import stoneLight1 from '../assets/images/stone-light-1.jpg';
import wine1 from '../assets/images/wine-cellar-1.jpg';
import wine2 from '../assets/images/wine-cellar-2.jpg';
import terrace1 from '../assets/images/terrace-1.jpg';
import cortenPlanters from '../assets/images/corten-planters.jpg';
import rockGarden from '../assets/images/rock-garden.jpg';
import garage1 from '../assets/images/garage-1.jpg';
import viewSvratka from '../assets/images/view-svratka.jpg';

import Button from '../components/Button.astro';
import Gallery from '../components/Gallery.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import UnitCard from '../components/UnitCard.astro';
import VideoHero from '../components/VideoHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import { site } from '../data/site';
import { units } from '../data/units';
import { path, t, withBase, siteRoot, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const c = dict.home;
const cs = locale === 'cs';

const galleryItems = [
  { src: stoneLight1, alt: cs ? 'Chodba s designovým kamenným osvětlením Anewstyle' : 'Corridor with designer Anewstyle stone lighting' },
  { src: wine1, alt: cs ? 'Soukromá vinotéka vytesaná ve skále' : 'Private wine cellar carved into the rock' },
  { src: terrace1, alt: cs ? 'Terasa s cortenovými truhlíky a výhledem do zeleně' : 'Terrace with corten planters looking out over greenery' },
  { src: rockGarden, alt: cs ? 'Skalní zahrada u vstupu do domu' : 'Rock garden at the entrance to the building' },
  { src: garage1, alt: cs ? 'Podzemní garáž viladomu' : 'The underground garage' },
  { src: cortenPlanters, alt: cs ? 'Cortenové truhlíky osázené zelení podél fasády' : 'Corten planters filled with greenery along the facade' },
  { src: wine2, alt: cs ? 'Vinný regál ve skalní stěně' : 'Wine racking set into the rock face' },
  { src: viewSvratka, alt: cs ? 'Výhled na meandr řeky Svratky' : 'View over the meander of the Svratka river' },
];

const priced = units.filter((u) => typeof u.price === 'number');
const activeUnits = units.filter((u) => u.status !== 'sold');
const availableCount = units.filter((u) => u.status === 'available').length;
const heroFacts = c.heroFacts.map((fact, index) =>
  index === 1
    ? {
        label: cs ? 'Aktuální nabídka' : 'Available now',
        value: cs ? `${availableCount} volné byty` : `${availableCount} homes`,
      }
    : fact,
);

const schema = [
  {
    '@type': 'ApartmentComplex',
    '@id': `${siteRoot()}#project`,
    name: site.name,
    url: siteRoot(),
    image: new URL(withBase('/og/home.jpg'), siteRoot()).href,
    description: c.seoDescription,
    numberOfAccommodationUnits: { '@type': 'QuantitativeValue', value: units.length },
    numberOfAvailableAccommodationUnits: {
      '@type': 'QuantitativeValue', value: units.filter((u) => u.status === 'available').length,
    },
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.street,
      addressLocality: `${site.city}-${site.district}`,
      postalCode: site.postalCode,
      addressCountry: site.country,
    },
    geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
    amenityFeature: [
      { '@type': 'LocationFeatureSpecification', name: cs ? 'Vinotéka ve skále' : 'Wine cellar in the rock', value: true },
      { '@type': 'LocationFeatureSpecification', name: cs ? 'Prosklený výtah' : 'Glass lift', value: true },
      { '@type': 'LocationFeatureSpecification', name: cs ? 'Podlahové vytápění' : 'Underfloor heating', value: true },
      { '@type': 'LocationFeatureSpecification', name: cs ? 'Garážové stání' : 'Garage parking', value: true },
    ],
    ...(priced.length
      ? {
          offers: {
            '@type': 'AggregateOffer',
            priceCurrency: 'CZK',
            lowPrice: Math.min(...priced.map((u) => u.price!)),
            highPrice: Math.max(...priced.map((u) => u.price!)),
            offerCount: priced.length,
            availability: 'https://schema.org/InStock',
          },
        }
      : {}),
  },
];
---

<BaseLayout
  locale={locale}
  routeKey="home"
  title={c.seoTitle}
  description={c.seoDescription}
  image={withBase("/og/home.jpg")}
  imageAlt={c.heroPosterAlt}
  schema={schema}
  overHero
>
  <VideoHero
    locale={locale}
    eyebrow={c.heroEyebrow}
    titleLines={[...c.heroTitleLines]}
    subtitle={c.heroSubtitle}
    posterAlt={c.heroPosterAlt}
    facts={heroFacts}
  >
    <Button href={path('units', locale)}>{dict.cta.viewUnits}</Button>
    <Button
      href={site.virtualTourUrl}
      variant="onDark"
      external
    >
      {dict.cta.virtualTour}
    </Button>
  </VideoHero>

  <!-- The decision surface comes first: buyers can see what is actionable
       before reading the longer project story. -->
  <Section id="byty" tone="surface" labelledby="units-title" class="home-availability">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
      <SectionHeading
        id="units-title"
        index="01"
        eyebrow={dict.nav.units}
        title={c.unitsTitle}
        lead={c.unitsSubtitle}
      />
      <div class="reveal hidden lg:block" data-reveal-delay="120">
        <Button href={path('units', locale)} variant="secondary">{dict.cta.viewUnits}</Button>
      </div>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-16 lg:grid-cols-3">
      {activeUnits.map((unit, index) => <UnitCard locale={locale} unit={unit} eager={index === 0} index={index} />)}
    </div>

    <div class="reveal mt-8 lg:hidden">
      <Button href={path('units', locale)} variant="secondary" class="w-full">{dict.cta.viewUnits}</Button>
    </div>
  </Section>

  <!-- Intro: text column with a figure breaking into the gutter ---------- -->
  <Section labelledby="intro-title">
    <SectionHeading id="intro-title" index="02" eyebrow={dict.nav.about} title={c.introTitle} />

    <div class="mt-16 grid gap-12 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-start lg:gap-20">
      <div class="reveal prose-vs text-lg text-muted lg:pt-4" data-reveal-delay="120">
        {c.introBody.map((para) => <p>{para}</p>)}
        <p class="text-base">{c.introStudios}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={path('about', locale)} variant="secondary">{dict.nav.about}</Button>
          <Button href={path('pricing', locale)} variant="ghost">{dict.cta.priceList}</Button>
        </div>
      </div>

      <figure class="reveal m-0 bleed-end" data-reveal-delay="200">
        <Image
          src={exteriorStreet}
          alt={cs
            ? 'Pohled na viladům Vila SCALA z Veslařské ulice'
            : 'The Vila SCALA villa house seen from Veslařská street'}
          widths={[380, 560, 760, 1000, 1240]}
          sizes="(min-width: 1024px) 46vw, 95vw"
          loading="lazy"
          class="aspect-[4/5] w-full object-cover"
        />
      </figure>
    </div>
  </Section>

  <!-- Proof points: concise project facts after the core story. ---------- -->
  <Section tone="surface" labelledby="stats-title">
    <h2 id="stats-title" class="sr-only">{c.statsTitle}</h2>
    <dl class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        c.stats.map((stat, i) => (
          <div class="reveal border-t border-line-strong pt-6" data-reveal-delay={i * 80}>
            <dt class="meta text-muted">{stat.label}</dt>
            <dd>
              <span class="mt-4 block font-display text-[clamp(3.5rem,7vw,6rem)] leading-[0.85] text-accent-text">
                {stat.value}
              </span>
              <span class="mt-4 block text-sm text-muted">{stat.detail}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- Highlights: two-column editorial list ------------------------------ -->
  <Section labelledby="highlights-title">
    <SectionHeading id="highlights-title" index="03" eyebrow={site.name} title={c.highlightsTitle} />
    <ul class="mt-16 grid border-t border-line sm:grid-cols-2">
      {
        c.highlights.map((h, i) => (
          <li
            class="reveal border-b border-line py-8 sm:odd:pr-10 sm:even:border-l sm:even:pl-10"
            data-reveal-delay={(i % 2) * 80}
          >
            <p class="meta text-accent-text">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-4 text-h3">{h.title}</h3>
            <p class="mt-3 max-w-md text-muted">{h.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Gallery ------------------------------------------------------------ -->
  <Section labelledby="gallery-title">
    <SectionHeading
      id="gallery-title"
      index="04"
      eyebrow={dict.unitsPage.galleryTitle}
      title={c.galleryTitle}
      lead={c.gallerySubtitle}
    />
    <Gallery locale={locale} items={galleryItems} class="mt-16" />
  </Section>

  <!-- Closing CTA over the evening exterior ------------------------------ -->
  <section class="relative isolate overflow-hidden bg-[#0b0908] text-[#f6f2ec]" aria-labelledby="cta-title">
    <Image
      src={exteriorEvening}
      alt=""
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="lazy"
      class="absolute inset-0 -z-20 size-full object-cover"
    />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[#0b0908]/78"></div>

    <div class="container-page py-28 sm:py-36">
      <div class="reveal max-w-3xl">
        <p class="meta text-[#f6f2ec]/60">05</p>
        <h2 id="cta-title" class="mt-6 text-h2">{c.ctaTitle}</h2>
        <p class="mt-6 max-w-xl text-lg text-[#f6f2ec]/85">{c.ctaBody}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={path('contact', locale)}>{dict.cta.contactUs}</Button>
          <Button
            href={site.virtualTourUrl}
            variant="onDark"
            external
          >
            {dict.cta.virtualTour}
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
