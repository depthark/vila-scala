---
import { site } from '../data/site';
import { absolute, alternates, locales, siteRoot, t, withBase, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: string;
  title: string;
  description: string;
  /** Absolute or root-relative URL of the social preview image. */
  image?: string;
  imageAlt?: string;
  /** JSON-LD graph nodes to embed. */
  schema?: unknown[];
  noindex?: boolean;
}

const {
  locale,
  routeKey,
  slug,
  title,
  description,
  image,
  imageAlt,
  schema = [],
  noindex = false,
} = Astro.props;

const dict = t(locale);
const canonical = absolute(Astro.url.pathname);
const links = noindex ? [] : alternates(routeKey, slug).map((a) => ({ ...a, href: absolute(a.href) }));
const ogImage = absolute(image ?? withBase('/og/home.jpg'));
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

const root = siteRoot();

const graph = [
  {
    '@type': 'Organization',
    '@id': `${root}#organization`,
    name: site.name,
    url: root,
    email: site.email,
    telephone: site.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.street,
      addressLocality: `${site.city}-${site.district}`,
      postalCode: site.postalCode,
      addressCountry: site.country,
    },
  },
  {
    '@type': 'WebSite',
    '@id': `${root}#website`,
    url: root,
    name: site.name,
    inLanguage: ['cs-CZ', 'en-GB'],
    publisher: { '@id': `${root}#organization` },
  },
  ...(!noindex ? [{
    '@type': routeKey === 'contact' ? 'ContactPage' : routeKey === 'about' ? 'AboutPage' : 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: fullTitle,
    description,
    inLanguage: dict.meta.locale,
    isPartOf: { '@id': `${root}#website` },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
  }] : []),
  ...schema,
];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

{links.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={locale === 'cs' ? 'cs_CZ' : 'en_GB'} />
{
  locales
    .filter((l) => l !== locale)
    .map((l) => <meta property="og:locale:alternate" content={l === 'cs' ? 'cs_CZ' : 'en_GB'} />)
}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:alt" content={imageAlt ?? title} />}
{(!image || image.endsWith('/og/home.jpg')) && <meta property="og:image:width" content="1200" />}
{(!image || image.endsWith('/og/home.jpg')) && <meta property="og:image:height" content="630" />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
<meta name="twitter:image:alt" content={imageAlt ?? title} />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')}
/>
