---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import Icon360 from './Icon360.astro';
import { tourEmbedUrl } from '../data/units';
import { fmt, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Matterport share link, e.g. https://my.matterport.com/show/?m=… */
  url: string;
  poster: ImageMetadata;
  /** Unit number as printed, e.g. "1039/3". */
  unit: string;
  /** Section id, so the tour can be linked to directly. */
  anchor: string;
  index?: string;
}
const { locale, url, poster, unit, anchor, index } = Astro.props;
const dict = t(locale);
const copy = dict.units;
const frameTitle = fmt(copy.tourFrameTitle, { unit });
---

<!--
  The tour is the most persuasive thing on the page short of a viewing, so
  it gets its own dark stage. Nothing from Matterport loads until the
  visitor asks for it: the poster is ours, and app.ts opens the tour in the
  Fancybox lightbox on click. Without JS the same control simply opens the
  tour in a new tab.
-->
<section
  id={anchor}
  aria-labelledby={`${anchor}-title`}
  class="relative isolate overflow-hidden bg-[#0b0908] py-20 text-[#f6f2ec] sm:py-28"
>
  <div class="container-page">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
      <div>
        <p class="reveal meta flex items-center gap-3 text-[#f6f2ec]/60">
          {index && <span class="text-accent">{index}</span>}
          {index && <span aria-hidden="true" class="h-px w-8 bg-current opacity-40" />}
          <span>{copy.tourEyebrow}</span>
        </p>
        <h2 id={`${anchor}-title`} class="mt-5 max-w-4xl text-h2">
          <span class="reveal-line"><span>{copy.tourTitle}</span></span>
        </h2>
        <p class="reveal mt-6 max-w-2xl text-lg text-[#f6f2ec]/75 sm:text-xl" data-reveal-delay="120">
          {copy.tourLead}
        </p>
      </div>
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="button-link reveal inline-flex min-h-12 items-center gap-2 justify-self-start rounded-full border border-[#f6f2ec]/45 px-6 text-[0.9375rem] font-medium transition-colors duration-200 hover:bg-[#f6f2ec]/12"
      >
        {copy.tourFullscreen}
        <svg class="size-4 shrink-0 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 4h6v6M20 4l-8.5 8.5M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4" />
        </svg>
      </a>
    </div>

    <div class="reveal relative mt-10 aspect-[4/5] overflow-hidden rounded-card bg-black sm:mt-14 sm:aspect-video" data-reveal-delay="160">
      <Image
        src={poster}
        alt=""
        widths={[640, 960, 1400, 1920]}
        sizes="(min-width: 1344px) 1200px, 92vw"
        loading="lazy"
        class="absolute inset-0 size-full scale-105 object-cover blur-[2px]"
      />
      <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgb(11_9_8/0.35)_0%,rgb(11_9_8/0.72)_75%)]"></div>

      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        data-tour-open
        data-src={tourEmbedUrl(url)}
        data-type="iframe"
        data-caption={frameTitle}
        class="button-link group absolute inset-0 flex flex-col items-center justify-center gap-6 p-6 text-center"
      >
        <span class="relative grid size-28 place-items-center rounded-full bg-accent text-accent-contrast shadow-[0_20px_60px_-10px_rgb(0_0_0/0.6)] transition-transform duration-300 ease-[var(--ease-editorial)] group-hover:scale-105 group-focus-visible:scale-105 sm:size-40">
          <span aria-hidden="true" class="absolute inset-0 animate-[ping_2.6s_cubic-bezier(0,0,0.2,1)_infinite] rounded-full bg-accent opacity-35 motion-reduce:hidden"></span>
          <span class="relative flex flex-col items-center leading-none">
            <span class="font-display text-4xl font-semibold tracking-tight sm:text-6xl">360°</span>
            <Icon360 class="mt-1.5 size-6 sm:size-8" />
          </span>
        </span>
        <span class="inline-flex min-h-12 items-center gap-2.5 rounded-full bg-[#f6f2ec] px-7 text-base font-medium text-[#0b0908] transition-colors duration-200 group-hover:bg-white">
          <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M4 2.6v10.8a1 1 0 0 0 1.53.85l8.4-5.4a1 1 0 0 0 0-1.7l-8.4-5.4A1 1 0 0 0 4 2.6Z" />
          </svg>
          {copy.tourStart}
        </span>
        <span class="meta text-[#f6f2ec]/70">{copy.tourHint}</span>
      </a>
    </div>
  </div>
</section>
